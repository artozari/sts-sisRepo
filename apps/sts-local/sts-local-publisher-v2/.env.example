# ===== Configuracion general =====
# API local sts-api (bootstrap). El resto de config del casino viene de DB Casino_table via GET /api/v1/casino?q=1
API_URL=http://127.0.0.1:8023

# ===== Broker MQTT LOCAL (sala) — via ConfigClass / archivo =====
LOCAL_MQTT_NAME=MQTT
LOCAL_SRV_NAME=STS_LOCAL_PUBLISHER
LOCAL_IP=192.168.0.212
LOCAL_URL_MQTT=127.0.0.1
LOCAL_PORT_MQTT=8883
LOCAL_USERNAME=Cartel
LOCAL_PASSWORD=Mqtt123.
LOCAL_PORT_HTTP=6000
LOCAL_PORT_HTTPS=6001
LOCAL_PROTOCOL=ws
LOCAL_SERVICE_ID=sts_local_publisher_100

# ===== Broker MQTT EXTERNO (Casino) — V2: ignorado si DB tiene mqtt_url =====
# Estos valores solo se usan como fallback si Casino_table está vacía al arrancar.
# En V2 el broker real se toma de Casino_table.mqtt_url/mqtt_port/mqtt_protocol/mqtt_user/mqtt_password
CASINO_MQTT_NAME=sielcondev01/9105
CASINO_SRV_NAME=STS_LOCAL_PUBLISHER
CASINO_IP=192.168.0.212
CASINO_URL_MQTT=dev01.sielcon.net
CASINO_PORT_MQTT=9105
CASINO_USERNAME=
CASINO_PASSWORD=
CASINO_PORT_HTTP=6000
CASINO_PORT_HTTPS=6001
CASINO_PROTOCOL=ws
CASINO_SERVICE_ID=sts_local_publisher_100
