{
    "name": "project-monorepo",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "npm run build --workspaces=true",
        "bundle:local": "node app_sts_bundle_local.js",
        "bundle:central": "node app_sts_bundle_central.js",
        "test_co": "vitest",
        "test:co": "npm run test_co --workspaces=true",
        "test_ui": "vitest",
        "test:ui": "npm run test_ui --workspaces=true",
        "start": "npm run start --workspaces=true",
        "api:dev": "npm run start:dev --workspace=sts-api",
        "api:win": "npm run start:win --workspace=sts-api",
        "api:lnx": "npm run start:lnx --workspace=sts-api",
        "hardware": "set configFile=apps/sts/sts-hardware/NotSign/config/config_sts-hardware.yml && node ./apps/sts/sts-hardware/dist/src/index.js",
        "hardware:win": "set configFile=apps/sts/sts-hardware/NotSign/config/config_sts-hardware.yml && node ./apps/sts/sts-hardware/dist/index.js",
        "hardware:lnx": "configFile=./apps/sts/sts-hardware/NotSign/config/config_sts-hardware.yml node ./apps/sts/sts-hardware/dist/index.js",
        "hardware:dev": "nodemon ./apps/sts/sts-hardware/src/index.ts --config ./__nodemon/nodemon.sts.hardware.json",
        "dashboard:dev": "nodemon ./apps/sts/sts-dashboard/src/index.ts --config ./__nodemon/nodemon.sts.dashboard.json",
        "wheel:dev": "nodemon ./apps/sts/sts-wheel/src/index.ts --config ./__nodemon/nodemon.sts.wheel.json",
        "wheel:win": "set configFile=apps/sts/sts-wheel/NotSign/config/config_sts-wheel.yml && node ./apps/sts/sts-wheel/dist/index.js",
        "wheel:lnx": "configFile=./apps/sts/sts-wheel/NotSign/config/config_sts-wheel.yml node ./apps/sts/sts-wheel/dist/index.js",
        "table:dev": "nodemon ./apps/sts/sts-table/src/index.ts --config ./__nodemon/nodemon.sts.table.json",
        "table:win": "set configFile=apps/sts/sts-table/NotSign/config/config_sts-table.yml && node ./apps/sts/sts-table/dist/index.js",
        "table:lnx": "configFile=./apps/sts/sts-table/NotSign/config/config_sts-table.yml node ./apps/sts/sts-table/dist/index.js",
        "local-publisher:win": "set configFile=apps/sts/sts-local-publisher/NotSign/config/config_sts-local-publisher.yml && node ./apps/sts/sts-local-publisher/dist/index.js",
        "local-publisher:dev": "nodemon ./apps/sts/sts-local-publisher/src/index.ts --config ./__nodemon/nodemon.sts.local-publisher.json"
    },
    "workspaces": [
        "packages/**/*",
        "apps/**/*"
    ],
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^8.57.0",
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.2",
        "@types/node": "^20.3.1",
        "@types/supertest": "^6.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vitest/coverage-v8": "^1.6.0",
        "@vitest/ui": "^1.6.0",
        "cpx2": "^7.0.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "globals": "^15.8.0",
        "jest": "^29.5.0",
        "prettier": "^3.0.0",
        "prisma": "^5.22.0",
        "rollup": "^4.18.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3",
        "typescript-eslint": "^7.10.0",
        "vitest": "^1.6.0"
    },
    "dependencies": {
        "@nestjs/cache-manager": "^2.2.2",
        "@nestjs/common": "^10.4.1",
        "@nestjs/core": "^10.4.1",
        "@nestjs/mapped-types": "*",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/swagger": "^7.4.0",
        "@prisma/client": "^5.22.0",
        "@slcn-pkg/catch-system-signals": "^1.0.0",
        "@slcn-pkg/config-class": "^1.0.4",
        "@slcn-pkg/express-app-class": "^1.0.0",
        "@slcn-pkg/general-logger-class": "^1.0.8",
        "@slcn-pkg/languages-class": "^1.0.2",
        "@slcn-pkg/mqtt-client-class": "^1.0.3",
        "bcryptjs": "^2.4.3",
        "cache-manager": "^5.7.6",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "node": "^22.5.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sts-common": "^1.0.0",
        "swagger-ui-express": "^5.0.1"
    }
}