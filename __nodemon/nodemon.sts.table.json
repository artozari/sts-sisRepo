{
    "restartable": "rs",
    "ignore": [
        ".git",
        "node_modules/**/node_modules",
        "apps/sts/sts-table/NotSign/**"
    ],
    "verbose": true,
    "execMap": {
        "js": "node --harmony"
    },
    "events": {
        "restart": "osascript -e 'display notification \"App restarted due to:\n'$FILENAME'\" with title \"nodemon\"'"
    },
    "watch": [
        "apps/sts/sts-table/*"
    ],
    "env": {
        "NODE_ENV": "development",
        "configFile": "apps/sts/sts-table/NotSign/config/config_sts-table.yml"
    },
    "ext": "ts,json"
}